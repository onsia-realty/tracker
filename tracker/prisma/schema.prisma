// 부정클릭 방지 + 방문자 추적 시스템
// Prisma Schema
// onsia-crm Supabase 프로젝트의 `tracker` 스키마 사용 (snake_case 매핑)

generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
  schemas   = ["tracker"]
}

// ========================================
// 인증 (관리자)
// ========================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
  @@schema("tracker")
}

// ========================================
// 랜딩 사이트 (분양현장별)
// ========================================

model LandingSite {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  subdomain   String?  @unique
  cheongyakId String?  @map("cheongyak_id")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sessions    VisitorSession[]
  pageViews   PageView[]
  clickEvents ClickEvent[]

  @@index([slug])
  @@index([isActive])
  @@map("landing_sites")
  @@schema("tracker")
}

// ========================================
// 방문자 세션 (핑거프린트 기반)
// ========================================

model VisitorSession {
  id             String  @id @default(cuid())

  fingerprint    String
  ipAddress      String? @map("ip_address")
  cookieId       String? @map("cookie_id")

  userAgent      String? @map("user_agent")
  deviceType     String? @map("device_type")
  deviceVendor   String? @map("device_vendor")
  deviceModel    String? @map("device_model")
  browser        String?
  browserVersion String? @map("browser_version")
  os             String?
  osVersion      String? @map("os_version")
  screenWidth    Int?    @map("screen_width")
  screenHeight   Int?    @map("screen_height")

  country     String?
  countryCode String? @map("country_code")
  region      String?
  city        String?
  isp         String?
  latitude    Float?
  longitude   Float?
  isVpn       Boolean @default(false) @map("is_vpn")
  isProxy     Boolean @default(false) @map("is_proxy")

  referrer       String?
  referrerDomain String? @map("referrer_domain")
  utmSource      String? @map("utm_source")
  utmMedium      String? @map("utm_medium")
  utmCampaign    String? @map("utm_campaign")
  utmContent     String? @map("utm_content")
  utmTerm        String? @map("utm_term")

  landingSiteId  String?      @map("landing_site_id")
  landingSite    LandingSite? @relation(fields: [landingSiteId], references: [id])
  firstVisit     DateTime     @default(now()) @map("first_visit")
  lastVisit      DateTime     @default(now()) @map("last_visit")
  visitCount     Int          @default(1) @map("visit_count")
  totalPageViews Int          @default(0) @map("total_page_views")
  totalDwellTime Int          @default(0) @map("total_dwell_time")

  riskScore    Int       @default(0) @map("risk_score")
  isSuspicious Boolean   @default(false) @map("is_suspicious")
  isBlocked    Boolean   @default(false) @map("is_blocked")
  blockReason  String?   @map("block_reason")
  blockedAt    DateTime? @map("blocked_at")

  pageViews   PageView[]
  clickEvents ClickEvent[]

  @@index([fingerprint])
  @@index([ipAddress])
  @@index([landingSiteId])
  @@index([firstVisit])
  @@index([lastVisit])
  @@index([riskScore])
  @@index([isBlocked])
  @@index([utmSource])
  @@map("visitor_sessions")
  @@schema("tracker")
}

// ========================================
// 페이지 조회 기록
// ========================================

model PageView {
  id String @id @default(cuid())

  sessionId String         @map("session_id")
  session   VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  landingSiteId String?      @map("landing_site_id")
  landingSite   LandingSite? @relation(fields: [landingSiteId], references: [id])

  path    String
  fullUrl String? @map("full_url")
  title   String?

  enterTime DateTime  @default(now()) @map("enter_time")
  exitTime  DateTime? @map("exit_time")
  dwellTime Int?      @map("dwell_time")

  scrollDepth    Int? @map("scroll_depth")
  scrollEvents   Int  @default(0) @map("scroll_events")
  mouseMovements Int  @default(0) @map("mouse_movements")
  clicks         Int  @default(0)

  exitType String? @map("exit_type")

  @@index([sessionId])
  @@index([landingSiteId])
  @@index([path])
  @@index([enterTime])
  @@map("page_views")
  @@schema("tracker")
}

// ========================================
// 클릭 이벤트 (광고/CTA 추적)
// ========================================

model ClickEvent {
  id String @id @default(cuid())

  sessionId String         @map("session_id")
  session   VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  landingSiteId String?      @map("landing_site_id")
  landingSite   LandingSite? @relation(fields: [landingSiteId], references: [id])

  eventType     String  @map("event_type")
  targetUrl     String? @map("target_url")
  targetElement String? @map("target_element")
  targetText    String? @map("target_text")

  clickX         Int? @map("click_x")
  clickY         Int? @map("click_y")
  viewportWidth  Int? @map("viewport_width")
  viewportHeight Int? @map("viewport_height")

  adSource   String? @map("ad_source")
  adCampaign String? @map("ad_campaign")
  adGroup    String? @map("ad_group")
  adKeyword  String? @map("ad_keyword")
  adCreative String? @map("ad_creative")

  pageUrl   String?  @map("page_url")
  timestamp DateTime @default(now())

  dwellTimeBeforeClick      Int? @map("dwell_time_before_click")
  scrollDepthBeforeClick    Int? @map("scroll_depth_before_click")
  mouseMovementsBeforeClick Int? @map("mouse_movements_before_click")

  isFraud     Boolean @default(false) @map("is_fraud")
  fraudReason String? @map("fraud_reason")
  fraudScore  Int     @default(0) @map("fraud_score")

  @@index([sessionId])
  @@index([landingSiteId])
  @@index([eventType])
  @@index([timestamp])
  @@index([isFraud])
  @@index([adSource])
  @@map("click_events")
  @@schema("tracker")
}

// ========================================
// 블랙리스트 (영구 차단)
// ========================================

model Blacklist {
  id          String  @id @default(cuid())
  fingerprint String? @unique
  ipAddress   String? @map("ip_address")
  reason      String
  evidence    String?

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  @@index([fingerprint])
  @@index([ipAddress])
  @@map("blacklist")
  @@schema("tracker")
}

// ========================================
// SMS 알림 발송 로그 (24h 내 중복 발송 방지)
// ========================================

model FraudAlertLog {
  id          String   @id @default(cuid())
  fingerprint String
  ipAddress   String?  @map("ip_address")
  siteSlug    String   @map("site_slug")
  riskScore   Int      @map("risk_score")
  reasons     String?  // comma-separated 사유 요약
  sentAt      DateTime @default(now()) @map("sent_at")
  smsResult   String?  @map("sms_result") // success | error message

  @@index([fingerprint, sentAt])
  @@index([ipAddress, sentAt])
  @@index([sentAt])
  @@map("fraud_alert_logs")
  @@schema("tracker")
}

// ========================================
// 일일 통계 (집계 테이블)
// ========================================

model DailyStats {
  id            String   @id @default(cuid())
  date          DateTime
  landingSiteId String?  @map("landing_site_id")

  uniqueVisitors Int @default(0) @map("unique_visitors")
  totalPageViews Int @default(0) @map("total_page_views")
  totalSessions  Int @default(0) @map("total_sessions")
  avgDwellTime   Int @default(0) @map("avg_dwell_time")
  bounceRate     Float @default(0) @map("bounce_rate")

  directVisits   Int @default(0) @map("direct_visits")
  naverAdVisits  Int @default(0) @map("naver_ad_visits")
  googleAdVisits Int @default(0) @map("google_ad_visits")
  organicVisits  Int @default(0) @map("organic_visits")
  otherVisits    Int @default(0) @map("other_visits")

  suspiciousClicks Int   @default(0) @map("suspicious_clicks")
  blockedClicks    Int   @default(0) @map("blocked_clicks")
  fraudScore       Float @default(0) @map("fraud_score")

  desktopVisits Int @default(0) @map("desktop_visits")
  mobileVisits  Int @default(0) @map("mobile_visits")
  tabletVisits  Int @default(0) @map("tablet_visits")

  @@unique([date, landingSiteId])
  @@index([date])
  @@index([landingSiteId])
  @@map("daily_stats")
  @@schema("tracker")
}
